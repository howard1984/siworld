{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SIVault",
  "version": "0.1.0",
  "identifier": "io.siworld.sivault",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "SIVault", "width": 1000, "height": 680, "minWidth": 360, "minHeight": 500, "dragDropEnabled": false }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; frame-src 'none'; form-action 'none'"
    }
  },
  "bundle": { "active": false }
}
